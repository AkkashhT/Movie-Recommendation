# Copy this to .env and fill in your values
# Get TMDB API key for free at https://www.themoviedb.org/settings/api

# Database
POSTGRES_DB=cinemate
POSTGRES_USER=cinemate
POSTGRES_PASSWORD=cinemate_secret_change_me

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_random_64_char_hex_string

# TMDB (required)
TMDB_API_KEY=your_tmdb_read_access_token_here

# Environment
ENVIRONMENT=development
VITE_API_URL=http://localhost:8000
